# Safeharbor archived business reports. Installed as /etc/cron.d/safeharbor-business-reports
# (root:root 0644); rename it to safeharbor-business-reports.disabled to pause reports.
# The wrapper holds the shared side of Safeharbor's deployment lock for its complete run.
# See docs/business-reports-contract.md, "Scheduler".
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

*/5 * * * * eightwest-safeharbor /usr/bin/bash /srv/8west/apps/safeharbor/current/cron/run_business_reports.sh
