    null,
    "none",
    "graph",
    "smtp",
    "php_mail"
  ],
  "types": {
    "schema_version": 3,
    "action": "hardware_staff_status",
    "ok": true,
    "ids": "Positive JSON integers, with the nullable exceptions below.",
    "no_device_contact_message_id": "Null until recorded, otherwise positive integer.",
    "staff_notice": "Null before staff receipt creation or if no fallback applied. Otherwise exact staff_notice_fields.",
    "recipient_user_id": "Null before any claim or when no recipient was selected; positive integer after claim.",
    "recipient_role": "Null with recipient_user_id null; otherwise owner, admin, or tech.",
    "mail_queue_id": "Null with recipient_user_id null; otherwise positive integer.",
    "attempt": "Null with recipient_user_id null; otherwise exact attempt_fields, even when suppressed after claim.",
    "number": "Positive JSON integer 1-5; stable identity with staff_notice.id.",
    "outcome": "Null in flight (queued); otherwise one of provider_accepted, failed, uncertain.",
    "transport": "Null in flight; otherwise none, graph, smtp, or php_mail.",
    "provider_http": "Null or JSON integer 100-599.",
    "attempted_at": "UTC timestamp YYYY-MM-DDTHH:MM:SSZ.",
    "completed_at": "Null in flight; otherwise UTC timestamp YYYY-MM-DDTHH:MM:SSZ.",
    "detail_code": "Bounded non-empty diagnostic identifier; never an address or provider payload."
  },
  "errors": {
    "legacy_receiver": "HTTP 422 invalid_fields for the exact new 9-field request; legacy hardware_status remains available.",
    "schema_unavailable": "HTTP 503 workflow_v3_unavailable after valid authentication/parsing on the new receiver with unavailable staff schema.",
    "finding_not_found": "HTTP 409 hardware_finding_not_found when the scoped finding cannot be found."
  },
  "evidence_limits": "Queued is a persisted claim, not provider acceptance. Provider acceptance is not inbox delivery or hardware repair. An unavailable or unsupported read does not erase previous receipts.",
